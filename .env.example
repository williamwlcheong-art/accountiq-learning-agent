# Copy this file to .env and fill in your values.
# Live AI is optional for local demo testing. Leave this blank unless you are
# using live research with a real key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the OpenAI model used for extraction, research and reports.
# OPENAI_MODEL=gpt-5.4-mini

# Optional: use a different folder for the versioned generic sector reports.
# The default is <project-root>/sector_reports.
# ACCOUNTIQ_SECTOR_REPORT_DIR=/absolute/path/to/sector_reports

# JWT signing key. Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-output-of-openssl-rand-hex-32

# Set to your email address to automatically grant admin access on first registration
# OWNER_EMAIL=your@email.com

# Phase 5: Email delivery (smtplib — swap to Resend in Phase 6)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
APP_BASE_URL=http://localhost:3000

# E2E test mode only
# ACCOUNTIQ_DB_PATH=data/accountiq_e2e.db
ACCOUNTIQ_E2E_MODE=false

# Local no-key demo mode only. This lets you test uploads, the five-question
# valuation journey and demo-labelled reports without a live OpenAI key.
# You can also start the backend with: scripts/start-demo-backend.sh
ACCOUNTIQ_DEMO_MODE=false

# Local no-login testing only. When true, protected routes use a deterministic
# local demo user so you can go straight to /wizard without registering.
# Do not enable this in a shared or production environment.
ACCOUNTIQ_AUTH_DISABLED=false
# ACCOUNTIQ_AUTH_BYPASS_EMAIL=demo@accountiq.local

# Next.js frontend
FASTAPI_ORIGIN=http://127.0.0.1:8765
NEXT_PUBLIC_API_BASE=/api/backend

# Legacy vanilla frontend fallback. The migrated app lives in web/.
ACCOUNTIQ_SERVE_LEGACY_FRONTEND=false
